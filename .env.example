# ===================================================================
# Microservices Environment Variable Template (.env.example)
# Copy this file to .env and fill in production secrets
# NEVER commit real credentials to git repositories!
# ===================================================================

# Database Credentials - REPLACE WITH STRONG PASSWORDS IN PRODUCTION
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=CHANGE_ME_USE_ENV_VAR

# Redis Credentials
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=6379
SPRING_REDIS_PASSWORD=CHANGE_ME_USE_ENV_VAR

# MinIO Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME_USE_ENV_VAR

# Telegram Bot Credentials
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_BOT_TOKEN=CHANGE_ME_GET_FROM_BOTFATHER

# Internal Server-to-Server Security Secret - MUST be at least 32 random chars
# Generate via: openssl rand -base64 48
INTERNAL_SERVICE_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_48

# JWT Secret - MUST be at least 64 chars for HS512
# Generate via: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64

# Application Security Settings
APP_SECURITY_COOKIE_SECURE=false
APP_SECURITY_RATE_LIMIT_ENABLED=true

# CORS Allowed Origins (comma-separated)
APP_SECURITY_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# JWT Access Token Expiration (15 minutes recommended)
JWT_EXPIRATION_MS=900000

# JWT Refresh Token Expiration (7 days recommended)
JWT_REFRESH_EXPIRATION_MS=604800000